# Rust
/target
**/*.rs.bk

# Node / frontend
node_modules/
ui/dist/
ui/node_modules/

# Tauri build output
src-tauri/target/
src-tauri/gen/

# Sidecar binaries staged by the build script (compiled artefacts, not source).
src-tauri/binaries/

# Models (downloaded separately — multi-GB, not committed)
*.gguf
*.bin

# OS / editor / tooling
.DS_Store
*.swp
.idea/
.vscode/
.playwright-mcp/

# Secrets — never commit. API keys live in the OS keychain, never in files.
.env
.env.*
*.pem
